{
  "_name": "Bouncer - Support Bounce Strategy (BULLISH ONLY)",
  "_version": "2.1.0",
  "_last_updated": "2026-01-01",
  "_setup": "Copy this file to config.json and fill in your credentials",

  "strategy": {
    "_comment": "Direction filter - currently BULLISH only (support bounces)",
    "allowed_directions": ["BULLISH"],
    "_allowed_directions_options": ["BULLISH", "BEARISH"],
    "level_types": ["support"],
    "_level_types_options": ["support", "resistance"]
  },

  "paths": {
    "kite_token": "../data/kite_access_token.json",
    "instruments_csv": "../data/stock_instruments.csv",
    "gsheet_credentials": "../data/secret.json",
    "logs_dir": "logs"
  },

  "stock_universe": {
    "_comment": "25-30 high liquidity F&O stocks. Update weekly based on OI ranking.",
    "_last_reviewed": "2025-12-31",
    "active_stocks": [
      "RELIANCE",
      "HDFCBANK",
      "ICICIBANK",
      "SBIN",
      "AXISBANK",
      "KOTAKBANK",
      "BAJFINANCE",
      "TATAMOTORS",
      "MARUTI",
      "LT",
      "INFY",
      "TCS",
      "BHARTIARTL",
      "ITC",
      "HINDUNILVR",
      "TATASTEEL",
      "JSWSTEEL",
      "ADANIENT",
      "POWERGRID",
      "M&M",
      "SUNPHARMA",
      "HCLTECH",
      "TITAN",
      "WIPRO",
      "NTPC"
    ],
    "exclude": []
  },

  "support_resistance": {
    "lookback_days": 180,
    "min_touches": 2,
    "touch_tolerance_pct": 1.0,
    "level_merge_pct": 1.5,
    "recency_bonus_days": 30,
    "max_level_distance_pct": 15.0
  },

  "scoring": {
    "touches_2": 10,
    "touches_3": 20,
    "touches_4_plus": 30,
    "polarity_flip": 25,
    "_comment_polarity": "Resistance turned support (polarity flip) - strong bullish signal",
    "round_number_confluence": 10,
    "high_volume_at_level": 15,
    "recent_touch": 10,
    "clean_bounce": 10,
    "min_score_to_trade": 40,
    "alert_score": 60
  },

  "entry_rules": {
    "max_distance_from_level_pct": 1.5,
    "min_dte": 10,
    "preferred_dte_min": 15,
    "preferred_dte_max": 30,
    "slippage": {
      "_comment": "Total slippage = (long_spread + short_spread) x lot_size",
      "max_entry_rs": 750,
      "skip_alert_rs": 1000
    }
  },

  "spread_config": {
    "_comment": "ATR-based targeting - adapts to each stock's volatility",
    "target_method": "atr",
    "atr_period": 14,
    "atr_multiplier": 1.5,
    "fallback_pct": 4.0,
    "min_spread_width_pct": 2.0,
    "max_spread_width_pct": 6.0,
    "max_debit_pct_of_width": 50,
    "min_risk_reward": 0.8
  },

  "position_sizing": {
    "max_risk_per_trade_pct": 2.0,
    "max_positions": 5,
    "max_same_sector": 2,
    "_comment": "All positions are LONG (bullish) - no direction limit needed",
    "default_lots": 1
  },

  "futures": {
    "enabled": true,
    "min_score": 90,
    "_comment": "Futures fallback for exceptional setups (90+ score) with illiquid options"
  },

  "reliability": {
    "min_success_rate": 0.30,
    "_comment": "Skip stocks with S/R success rate below 30%"
  },

  "exit_rules": {
    "profit_target_1_pct": 50,
    "profit_target_2_pct": 80,
    "stop_loss_level_break_pct": 1.5,
    "time_stop_days": 10,
    "exit_before_dte": 5
  },

  "google_sheets": {
    "enabled": false,
    "spreadsheet_id": "YOUR_SPREADSHEET_ID",
    "sheet_name": "Bouncer_Setups",
    "update_interval_mins": 5
  },

  "telegram": {
    "enabled": true,
    "bot_token": "YOUR_BOT_TOKEN",
    "chat_id": "YOUR_CHAT_ID",
    "alert_score": 60,
    "send_summary": true,
    "quiet_hours": {
      "start": "15:30",
      "end": "09:15"
    }
  },

  "scanner": {
    "interval_mins": 5,
    "market_hours": {
      "start": "09:15",
      "end": "15:30"
    },
    "timezone": "Asia/Kolkata"
  },

  "round_numbers": {
    "below_500": [50, 100, 150, 200, 250, 300, 350, 400, 450, 500],
    "500_to_1000": [500, 550, 600, 650, 700, 750, 800, 850, 900, 950, 1000],
    "1000_to_2000": [1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900, 2000],
    "2000_to_5000": [2000, 2250, 2500, 2750, 3000, 3500, 4000, 4500, 5000],
    "above_5000": [5000, 5500, 6000, 6500, 7000, 7500, 8000, 9000, 10000]
