# Environment and Credentials
.env
.env.*
*.env

# ===========================================
# SECURITY: Exclude all sensitive files
# ===========================================

# All markdown files (CLAUDE.md, ISSUES.md, REVIEW_SUMMARY.md, etc.)
# Keep only README.md files
*.md
!README.md
!**/README.md

# Credential files (API keys, tokens, secrets)
**/credentials.yaml
**/credentials.json
**/secret.json
**/config.json
**/config.yaml
!**/config.sample.json
!**/config.sample.yaml
!**/config.template.json
!**/config.template.yaml

# Kite/Zerodha tokens
**/kite_access_token.json
**/kite_credentials.json

# Kotak Neo credentials
Scalper/config/credentials.yaml

# CROCODILE config (has credentials)
CROCODILE/config/config.yaml

