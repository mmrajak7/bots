# FIFTY Bot Configuration Template
# Copy this file to config.yaml and fill in your values
# IMPORTANT: Never commit config.yaml to git (contains secrets)

# Bot Instance Configuration
bot:
  instance_id: "fifty_main"
  log_level: "INFO"

# Kite API Configuration (for market data - shared token)
kite_read:
  token_file: "../data/kite_access_token.json"  # Shared token from SNAIL
  validate_token_date: true

# Kite API Configuration (for trading - dedicated account)
kite_trade:
  credentials_file: "data/kite_credentials.json"
  token_file: "data/kite_access_token.json"
  order_tag: "fifty"
  rate_limit_delay: 1.0

# Telegram Configuration
telegram:
  bot_token: "YOUR_TELEGRAM_BOT_TOKEN"  # Get from @BotFather
  chat_id: "YOUR_CHAT_ID"               # Get from @userinfobot
  enabled: true
  retry_attempts: 3
  retry_delay: 5
  daemon_lifecycle_alerts: false  # suppress "Service Started"/"Daemon Stopped" telegram messages (daily restart noise)

# Signal Source Configuration
signals:
  file_path: "/home/trustit/Desktop/Scripts/op_signals.csv"
  filter_tf: "CSP"  # Filter for CSP signals only
  ignore_list_file: "data/ignore_list.csv"
  start_date: "2026-01-26"  # Only process signals after this date

# Trading Parameters
trading:
  test_mode: 'X'  # 'X' for test mode (1 qty), '' for production
  initial_capital: 100000
  per_trade_amount: 10000  # capital-neutral: initial_capital / max_positions (100K / 10)
  max_positions: 10        # 10 slots beats 5 (same total return, ~half the worst-year drawdown, more monster capture)
  max_pending_orders: 3
  min_price: 100  # skip signals below Rs 100 (circuit micro-caps: backtest fills are fiction)
  initial_sl_percent: 20

# Risk Management
risk:
  emergency_drop_percent: 30
  trailing_sl_method: "monthly_low"
  sl_gtt_limit_buffer_percent: 2.0

# NIFTY Weekly Filter
nifty_filter:
  enabled: true
  instrument_token: "256265"
  mode: stretch          # 'stretch' (gate: weekly (close-ST)/ATR <= stretch_high) | 'binary' (legacy ST trend up)
  stretch_high: 2.0      # block new entries when NIFTY weekly stretch exceeds this (over-extended). No lower bound.
  conviction_enabled: true  # show NIFTY monthly stretch conviction stars (★) in signal alerts (context only, not a gate)

# Market Regime Gate (validated 2020-2026, Helper/20/06_hybrid_validation.md)
# Pauses NEW entries when market internals die; deep capitulation overrides.
# ENTRIES ONLY - exits (20% SL + monthly-low trail) are never touched.
regime:
  enabled: true
  rsi_threshold: 50            # NIFTY daily RSI(14) > 50 = signal ON
  breadth_threshold: 40        # % of universe above own 50DMA > 40 = signal ON
  sma_period: 50               # NIFTY close > 50DMA = signal ON
  unpause_days: 7              # 2-of-3 ON for 7 straight sessions to resume
  deep_override_stretch: -2.0  # allow entries while paused if weekly stretch <= this
  breadth_min_coverage: 300    # min symbols with data to trust the breadth reading

# SuperTrend Configuration
supertrend:
  period: 10
  multiplier: 3
  cache_expiry_minutes: 60

# Historical Data Lookback
historical_data:
  monthly_lookback_years: 3.0
  weekly_lookback_years: 1.5
  daily_lookback_years: 1.0

# Schedule (IST times)
schedule:
  morning_startup: "09:00"
  market_open: "09:15"
  market_close: "15:30"
  hold_renotify: "09:30"
  eod_sl_update: "15:50"
  recovery: "16:00"
  daily_report: "16:10"
  weekly_report: "16:15"
  monthly_cleanup: "16:25"
  cron_interval_minutes: 5

# Database Configuration
database:
  url: "sqlite:///data/trading.db"
  echo: false

# Logging Configuration
logging:
  log_dir: "logs"
  file_path: "logs/fifty_{time:YYYY-MM-DD}.log"
  level: "INFO"
  rotation: "1 day"
  retention: "45 days"
  format: "{time:YYYY-MM-DD HH:mm:ss} | {level: <8} | {name}:{function}:{line} - {message}"

# Instruments Cache
instruments:
  cache_file: "data/instruments.csv"
  max_age_hours: 24

# Transaction Costs
transaction_costs:
  brokerage_delivery: 0.0
  stt_percent: 0.001
  exchange_charges_percent: 0.0000325
  gst_percent: 0.18
  sebi_charges_percent: 0.000001
  stamp_duty_percent: 0.00015

# API Resilience
api_resilience:
  retry:
    max_attempts: 3
    base_delay: 1.0
    max_delay: 16.0
    exponential_base: 2.0
  circuit_breaker:
    enabled: true
    consecutive_failures:
      critical_operations: 3
      standard_operations: 5
    failure_window: 300
    auto_reset:
      enabled: true
      cooldown_minutes: 30
    manual_reset_file: "data/circuit_breaker_reset.flag"
    actions:
      halt_trading: true
      halt_order_placement: true
      allow_exits: true
      allow_gtt_updates: true
      send_critical_alert: true

# Market Hours (IST)
market_hours:
  pre_market_start: "09:00"
  market_open: "09:15"
  market_close: "15:30"
  post_market_end: "16:00"
  trading_days: [1, 2, 3, 4, 5]
