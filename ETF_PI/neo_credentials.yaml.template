# Kotak Neo API Credentials
# Copy this file to neo_credentials.yaml and fill in your values.
# DO NOT commit neo_credentials.yaml to git.
#
# Get consumer_key from: Kotak Neo App > More > Trade API
# TOTP secret from: Authenticator app setup (base32 string)

neo_credentials:
  consumer_key: ""          # UUID from Kotak Neo developer portal
  mobile_number: ""         # +91XXXXXXXXXX
  ucc: ""                   # User Client Code (e.g., Y6W82)
  mpin: ""                  # 6-digit MPIN
  totp_secret: ""           # Base32 TOTP secret from authenticator setup

# SEBI mandate (Apr 1, 2026): API orders must originate from registered static IP.
# Register at: Kotak Neo App > More > Trade API > Manage Whitelisted IPs
# Max 2 IPs, changeable once per 7 days.
static_ip: ""               # Your registered IP (for logging/awareness only)
